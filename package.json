{
  "name": "streamdex",
  "version": "0.1.0-beta.2",
  "private": true,
  "type": "module",
  "description": "An experiment in ways of working with agentic workflows using Stream Deck+ and Mobile",
  "author": "Streamdex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsack/streamdex.git"
  },
  "homepage": "https://github.com/danielsack/streamdex#readme",
  "keywords": [
    "codex",
    "stream-deck",
    "stream-deck-plus",
    "macos",
    "openai"
  ],
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:custom": "node --test test/custom/*.test.mjs",
    "pack": "node scripts/package.mjs",
    "audit:local": "node scripts/audit.mjs",
    "check": "npm run typecheck && npm run check:docs && npm run test:audit && npm run build && npm run pack && npm run check:version && npm test && npm run test:custom && npm run audit:local",
    "test:fast": "vitest run --project unit",
    "test:audit": "python3 -m unittest discover -s test -p 'audit_test.py' -v",
    "check:docs": "node scripts/check-docs.mjs",
    "audit:source": "node scripts/audit.mjs --source-only",
    "version:set": "node scripts/version.mjs",
    "check:version": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.2"
  },
  "devDependencies": {
    "@elgato/cli": "1.9.0",
    "@types/node": "26.4.0",
    "esbuild": "0.28.2",
    "lucide-static": "1.38.0",
    "opentype.js": "1.3.4",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  }
}
